{% if page.archive %}
<h1>{{ page.heading }}</h1>
<form class="blog__search" action="{{ site.archive_url }}" method="get" role="search">
  {% if page.preview_token %}<input type="hidden" name="blog_theme_preview" value="{{ page.preview_token }}">{% endif %}
  <label for="blog-search">{{ labels.search }}</label><input id="blog-search" type="search" name="q" value="{{ page.query }}" maxlength="100"><button type="submit">{{ labels.search }}</button>
</form>
{% endif %}
{% for article in articles %}
<article class="sam-blog__post">
  <header><h2><a href="{{ article.url }}">{{ article.title }}</a></h2><p>{{ article.relative_date }}</p></header>
  <div class="sam-blog__post-body"><p>{{ article.excerpt }}</p><p><a class="sam-blog__read-more" href="{{ article.url }}">{{ labels.continue_reading }}</a></p></div>
  <footer class="sam-blog__post-footer"><p>{{ labels.posted_by }}: {{ article.author }} &nbsp; <a href="{{ article.url }}">{{ labels.permalink }}</a> | <a href="{{ article.url }}#discussion">{{ labels.comments }}{% if article.replies > 0 %} ({{ article.replies }}){% endif %}</a></p></footer>
</article>
{% else %}<h2>{{ labels.empty_title }}</h2><p>{{ labels.empty_body }}</p>{% endfor %}
<nav class="blog__pagination" aria-label="{{ labels.pagination }}">
  {% if page.previous_url %}<a rel="prev" href="{{ page.previous_url }}">← {{ labels.newer }}</a>{% endif %}
  {% if page.next_url %}<a rel="next" href="{{ page.next_url }}">{{ labels.older }} →</a>{% endif %}
</nav>
