<div class="sam-blog">
  <header class="sam-blog__header">
    <div class="sam-blog__identity">
      <div>
        {% if page.title == site.title and page.archive == false %}
        <h1 class="sam-blog__site-heading"><a class="sam-blog__title" href="{{ site.url }}">{{ site.title }}</a></h1>
        {% else %}
        <a class="sam-blog__title" href="{{ site.url }}">{{ site.title }}</a>
        {% endif %}
        <p class="sam-blog__tagline">{{ site.description }}</p>
      </div>
      <ul class="sam-blog__topics"><li>Discourse</li><li>Ruby</li><li>MiniProfiler</li><li>SQL</li><li>AI</li></ul>
    </div>
    <nav class="sam-blog__nav" aria-label="{{ labels.navigation }}">
      <a href="{{ site.url }}"{% if page.title == site.title and page.archive == false %} aria-current="page"{% endif %}>{{ labels.home }}</a>
      <a href="{{ site.about_url }}"{% if page.title == labels.about %} aria-current="page"{% endif %}>{{ labels.about }}</a>
      <a href="{{ site.archive_url }}"{% if page.archive %} aria-current="page"{% endif %}>{{ labels.archive }}</a>
      <a class="sam-blog__nav-feed" href="{{ site.feed_url }}">{{ labels.rss }}</a>
    </nav>
  </header>
  <div class="sam-blog__columns{% if article %} --article{% endif %}">
    <main id="main" class="sam-blog__content">{{ content_html }}</main>
    <aside class="sam-blog__sidebar">
      <section>
        <h2>{{ labels.on_social }}</h2>
        <ul>
          <li><a class="sam-blog__profile-link" href="https://ruby.social/@samsaffron" rel="me">Mastodon<small>@samsaffron@ruby.social</small></a></li>
          <li><a class="sam-blog__profile-link" href="https://bsky.app/profile/samsaffron1.bsky.social" rel="me">Bluesky<small>@samsaffron1.bsky.social</small></a></li>
          <li><a class="sam-blog__profile-link" href="https://twitter.com/samsaffron" rel="me">Twitter<small>@samsaffron</small></a></li>
        </ul>
      </section>
      <section>
        <h2>{{ labels.community_activity }}</h2>
        <a class="sam-blog__profile-link" href="https://meta.discourse.org/u/sam/activity">Discourse Meta <span aria-hidden="true">↗</span></a>
      </section>
      <section>
        <h2>{{ labels.online_content }}</h2>
        <ul>
          <li><a href="https://www.youtube.com/watch?v=aP5NNkzb4og">Off the Rails</a></li>
          <li><a href="https://www.youtube.com/watch?v=LWyEWUD-ztQ">Measuring Ruby</a></li>
          <li><a href="https://www.youtube.com/watch?v=kici_QRQbOM">Why I am excited about Ruby 2.1?</a></li>
          <li><a href="https://topenddevs.com/podcasts/ruby-rogues/episodes/161-rr-docker-deploys-with-sam-saffron">Docker Deploys on Ruby Rogues</a></li>
          <li><a href="https://topenddevs.com/podcasts/ruby-rogues/episodes/117-rr-discourse-part-2-with-sam-saffron-and-robin-ward">Discourse on Ruby Rogues</a></li>
        </ul>
      </section>
      <section>
        <h2>{{ labels.about }}</h2>
        <p>{{ site.description }}</p>
        <a class="sam-blog__about-link" href="{{ site.about_url }}">{{ labels.continue_reading }} <span aria-hidden="true">→</span></a>
      </section>
    </aside>
  </div>
  <footer class="sam-blog__footer">
    <span>{{ labels.syndication }}: <a href="{{ site.feed_url }}">{{ labels.rss }}</a></span>
    <a href="{{ site.archive_url }}">{{ labels.archive }}</a>
  </footer>
</div>
