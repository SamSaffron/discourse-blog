<div class="sam-blog">
  <header class="sam-blog__header">
    <div class="sam-blog__identity">
      <div><a class="sam-blog__title" href="{{ site.url }}">{{ site.title }}</a><p class="sam-blog__tagline">{{ site.description }}</p></div>
      <ul class="sam-blog__topics"><li>Discourse</li><li>Ruby</li><li>MiniProfiler</li><li>SQL</li><li>AI</li></ul>
    </div>
    <nav class="sam-blog__nav" aria-label="{{ labels.navigation }}"><a href="{{ site.url }}">{{ labels.home }}</a><a href="{{ site.about_url }}">{{ labels.about }}</a></nav>
  </header>
  <div class="sam-blog__columns">
    <main id="main" class="sam-blog__content">{{ content_html }}</main>
    <aside class="sam-blog__sidebar">
      <section><h2>{{ labels.twitter_updates }}</h2><ul><li><a href="https://twitter.com/samsaffron">@samsaffron</a></li></ul></section>
      <section><h2>{{ labels.community_activity }}</h2><ul><li><a href="{{ site.community_url }}">{{ labels.community }}</a></li></ul></section>
      <section><h2>{{ labels.online_content }}</h2><ul>
        <li><a href="https://www.youtube.com/watch?v=aP5NNkzb4og">Off the Rails</a></li>
        <li><a href="https://www.youtube.com/watch?v=LWyEWUD-ztQ">Measuring Ruby</a></li>
        <li><a href="https://www.youtube.com/watch?v=kici_QRQbOM">Why I am excited about Ruby 2.1?</a></li>
        <li><a href="https://topenddevs.com/podcasts/ruby-rogues/episodes/161-rr-docker-deploys-with-sam-saffron">Docker Deploys on Ruby Rogues</a></li>
        <li><a href="https://topenddevs.com/podcasts/ruby-rogues/episodes/117-rr-discourse-part-2-with-sam-saffron-and-robin-ward">Discourse on Ruby Rogues</a></li>
      </ul></section>
      <section><h2><a href="https://stackexchange.com/users/9321">Stack Overflow</a></h2><ul>
        <li><a href="https://stackoverflow.com/users/17174/sam-saffron?tab=questions">{{ labels.recent_questions }}</a></li>
        <li><a href="https://stackoverflow.com/users/17174/sam-saffron?tab=answers">{{ labels.recent_answers }}</a></li>
      </ul></section>
      <section><h2>{{ labels.about }}</h2><p>{{ site.description }}</p><a href="{{ site.about_url }}">{{ labels.continue_reading }}</a></section>
    </aside>
  </div>
  <footer class="sam-blog__footer">{{ labels.syndication }}: <a href="{{ site.feed_url }}">{{ labels.rss }}</a> · <a href="{{ site.archive_url }}">{{ labels.archive }}</a></footer>
</div>
